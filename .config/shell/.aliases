# Aliases shared by zsh and fish, translated by convert_shell_config.fish.
# Keep every body parseable by both shells: no bash subshells, and write a
# literal $ as \$ so fish does not read it as the start of a variable.

# Listing (eza replaces the abandoned exa)
alias ls='eza -al --color=always --group-directories-first --icons=auto'  # preferred listing
alias la='eza -a --color=always --group-directories-first --icons=auto'   # all files and dirs
alias ll='eza -l --color=always --group-directories-first --icons=auto'   # long format
alias lt='eza -aT --color=always --group-directories-first --icons=auto'  # tree listing
alias l.='eza -d --color=always --group-directories-first --icons=auto .*' # only dotfiles

# Modern CLI tool overrides
alias cat='bat --style=plain'  # syntax-highlighted cat

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'

# Core utilities & defaults
alias ff='fastfetch'
alias hw='hwinfo --short'
alias wget='wget -c'
alias grep='grep --color=auto'

# Archives
alias tarnow='tar -acf'
alias untar='tar -zxvf'

# Systemd, logging & audio
alias jctl='journalctl -p 3 -xb'
alias failed='systemctl --failed'
alias userfailed='systemctl --user --failed'
alias fixaudio='systemctl --user restart pipewire.socket pipewire wireplumber'

# Config editors
alias ac='$EDITOR ~/.config/shell/.aliases'
alias ec='$EDITOR ~/.config/shell/.env_vars'

# Misc tools
alias docker='sudo docker'
alias vencord-install='sh -c "$(curl -sS https://raw.githubusercontent.com/Vendicated/VencordInstaller/main/install.sh)"'

# Network & VPN
alias vpnhomenetwork='sudo wg-quick up homenetwork'

# Arch specific
alias pacman='sudo pacman'  # queries below use `command pacman` to skip this
alias rmpaclock='sudo rm /var/lib/pacman/db.lck'
alias rmpkg='sudo pacman -Rdd'
alias gitpkg='command pacman -Qq | grep -c -- "-git\$"' # count of -git packages
alias cleanup='sudo pacman -Rns $(command pacman -Qtdq)' # remove orphaned packages
alias big='expac -H M "%m\t%n" | sort -h | nl'   # installed packages by size
alias rip='expac --timefmt="%Y-%m-%d %T" "%l\t%n %v" | sort | tail -200 | nl' # last installed

# Java - Arch specific
alias java-g='archlinux-java get'
alias java-s='archlinux-java status'
alias java-set8='sudo archlinux-java set java-8-openjdk'
alias java-set11='sudo archlinux-java set java-11-openjdk'
alias java-set17='sudo archlinux-java set java-17-openjdk'
alias java-set21='sudo archlinux-java set java-21-openjdk'

# KDE specific
alias plasmarestart='systemctl --user restart plasma-plasmashell'
alias fixkwin='qdbus6 org.kde.KWin /KWin reconfigure'
alias mailspring='mailspring --password-store="kwallet5"'

# Switch used GPU - hybrid GPUs (internal + NVIDIA)
alias getgpu='optimus-manager --print-mode'
alias integratedgpu='optimus-manager --switch integrated --no-confirm'
alias nvidiagpu='optimus-manager --switch nvidia --no-confirm'
alias hybridgpu='optimus-manager --switch hybrid --no-confirm'

# Hacking with airmon :)
alias wlan-monitor='sudo airmon-ng start wlo1 && sudo airmon-ng check kill'
alias wlan-managed='sudo airmon-ng stop wlo1mon && sudo systemctl restart NetworkManager'
alias airodump='sudo airodump-ng wlo1mon'
alias clearshakes='sudo rm -i ~/Documents/Aircrack/Handshakes/*'
alias deauth='sudo aireplay-ng wlo1mon --deauth'

# Project shortcuts
alias cshack='env -C ~/Dev/Rust/deadlocked cargo run --release &'
